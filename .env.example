SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SITE_URL=http://localhost:5500

LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_REDIRECT_URI=http://localhost:5500/linkedin-callback.html
LINKEDIN_EXCHANGE_ENDPOINT=/.netlify/functions/linkedin-exchange

# Server-side only: setează în Supabase Dashboard > Edge Functions > Secrets,
# nu în frontend și nu în config/env.js.
GEMINI_API_KEY=your_gemini_api_key_for_chat_function
GEMINI_MODEL=gemini-2.5-flash
